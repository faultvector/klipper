# Kconfig settings for NXP MCX processors

if MACH_MCX

config MCX_SELECT
    bool
    default y
    select SERIAL

config BOARD_DIRECTORY
    string
    default "mcx"

choice
    prompt "Processor model"

config MACH_MCXA366
    bool "MCXA366"

endchoice

config MCU
    string
    default "mcxa366" if MACH_MCXA366

config FLASH_SIZE
    hex
    default 0xFE000

config FLASH_BOOT_ADDRESS
    hex
    default 0x00000000

config FLASH_APPLICATION_ADDRESS
    hex
    default 0x00000000

config RAM_START
    hex
    default 0x20000000

config RAM_SIZE
    hex
    default 0x3C000

config STACK_SIZE
    int
    default 2048

endif